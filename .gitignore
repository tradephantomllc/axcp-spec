# Rust
# Build directories
/target/
**/target/
**/target/**/*

# Cargo lock and cache files (the SDK lockfile is tracked)
Cargo.lock
!sdk/rust/Cargo.lock
*.crate
.cargo/credentials
.cargo-target/

# Backup files
**/*.rs.bk
**/*.rs.bk.*

# Debug and profiling files
debug/
release/
*.pdb
*.dSYM/
*.profdata
*.profraw

# Files generated by rustfmt
**/*.rs.bk

# Generated documentation
/doc/
**/doc/

# Test output
/test-results/
**/test-results/

# Go
# Dependencies
/vendor/
**/vendor/

# Go workspace files: the repository-root go.work and go.work.sum are tracked;
# workspace files created in subdirectories are ignored.
**/go.work
**/go.work.sum
!/go.work
!/go.work.sum

# Binaries and executables
/bin/
**/bin/
# Binaries built by `go build` inside an example directory
examples/go/simple_chat/simple_chat
examples/go/authenticated_chat/authenticated_chat
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and output
*.test
*.out

# Coverage files
coverage.txt
profile.cov
*.cover
*.cover.html

# Debug files
debug/
**/debug/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/

# TypeScript / Node
node_modules/
**/node_modules/
dist/
**/dist/
*.tsbuildinfo

# Build artifacts
/target/
**/target/
out/

# Crate packages
**/target/package/

# Local development
.env
.env.local

# Logs (committed protocol-proof evidence logs are kept)
*.log
!artifacts/protocol-proof/**/*.log

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Internal documentation (local only, not for remote)
CLAUDE.md
*.internal.md
RESTRUCTURING_PLAN.md
*_PLAN.md
*_ROADMAP_INTERNAL.md
ROADMAP_OPERATIONAL.md
FINAL_DECISIONS.md
EXECUTIVE_SUMMARY_FOR_PM.md
SESSION_REPORT*.md
AUDIT_*.md
